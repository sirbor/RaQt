generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Marketing homepage JSON (merged with code defaults in the app).
model SiteContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum UserRole {
  CLIENT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)
  cartItems    CartItem[]
  orders       DemoOrder[]
  createdAdminCodes AdminSetupCode[] @relation("AdminCodeCreator")
  usedAdminCodes    AdminSetupCode[] @relation("AdminCodeUsedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminSetupCode {
  id           String   @id @default(cuid())
  codeHash     String
  createdById  String
  createdBy    User     @relation("AdminCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedByUserId String?
  usedByUser   User?    @relation("AdminCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
  usedAt       DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model UseCase {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  summary     String
  priceCents  Int
  category    String
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  cartItems   CartItem[]
  orderItems  DemoOrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  useCaseId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  useCase    UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([userId, useCaseId])
}

enum DemoOrderStatus {
  PENDING
  PLACED
}

model DemoOrder {
  id          String          @id @default(cuid())
  userId      String
  status      DemoOrderStatus @default(PLACED)
  totalCents  Int
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       DemoOrderItem[]
}

model DemoOrderItem {
  id          String    @id @default(cuid())
  orderId     String
  useCaseId   String
  quantity    Int
  unitCents   Int
  createdAt   DateTime  @default(now())
  order       DemoOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  useCase     UseCase   @relation(fields: [useCaseId], references: [id], onDelete: Restrict)
}
